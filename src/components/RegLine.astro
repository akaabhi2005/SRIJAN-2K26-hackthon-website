---
// Static IST deadline line (correct with no JS), upgraded by src/scripts/reg-countdown.ts to a clock (DD : HH : MM : SS, aria-hidden)
// plus one screen-reader line written at most once a minute. `live` marks the single instance that announces (aria-live polite).
import data from '../data/event.json';
const { closes, countdown: cd } = data.registration;
const parts = Object.fromEntries(new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit', hourCycle: 'h12' }).formatToParts(new Date(closes)).map((p) => [p.type, p.value]));
const when = `${parts.day} ${parts.month} ${parts.year}, ${parts.hour}:${parts.minute} ${String(parts.dayPeriod).toUpperCase()} IST`;
const { cls = '', live = false } = Astro.props;
---
<p class={`regline ${cls}`} data-reg-closes={closes} data-state="static" data-lead={cd.lead} data-compact={cd.compact} data-closed={cd.closed} data-units={cd.units.join(',')} {...(live ? { 'data-live': '' } : {})}>
  <span class="rl-static"><span class="rl-ext-badge">EXTENDED</span> Registration closes {when}</span>
  <span class="rl-clock" hidden aria-hidden="true">
    <span class="rl-ext-badge">EXTENDED</span>
    <span class="rl-lead">{cd.lead}</span>
    {cd.units.map((u, i) => <>{i > 0 && <span class="rl-colon">:</span>}<span class="rl-unit"><span class="rl-num"><span class="rl-d">-</span><span class="rl-d">-</span></span><span class="rl-lbl">{u}</span></span></>)}
  </span>
</p>
