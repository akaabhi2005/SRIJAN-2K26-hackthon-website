---
import Img from './Img.astro';
import '../styles/story.css';
import data from '../data/event.json';
import Skyline from './Skyline.astro';
import RegLine from './RegLine.astro';
import '../styles/skyline.css';
import '../styles/hero-cards-fx.css';
import '../styles/motion-fx.css';
import '../styles/bold.css';
import paytm from '../assets/sponsors/paytm.webp';
import xyz from '../assets/sponsors/xyz.webp';
import macrovisionAi from '../assets/sponsors/macrovision-ai-black.webp';

const { event: ev, register, tracks, sponsors, contact, story, prizes } = data;
const logos: Record<string, ImageMetadata> = { paytm, xyz, 'macrovision-ai': macrovisionAi };
const ii = ev.name.indexOf('I');
const nameA = ev.name.slice(0, ii), nameI = ev.name[ii], nameB = ev.name.slice(ii + 1);
const arrow = 'M5 12h14M13 6l6 6-6 6';
const icons: Record<string, string> = {
  ai: 'M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3M7 6h10a1 1 0 011 1v10a1 1 0 01-1 1H7a1 1 0 01-1-1V7a1 1 0 011-1zM10 10h4v4h-4z',
  web: 'M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16',
  shield: 'M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6l8-3zM9 12l2 2 4-4',
  campus: 'M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6M9 11h.01M15 11h.01',
  leaf: 'M5 19c0-9 5-14 15-14 0 10-5 15-14 15M5 19c2-5 5-8 9-10',
  open: 'M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3zM12 12l8-4.5M12 12L4 7.5M12 12v9',
};
const chip = {
  cal: 'M3 6a2 2 0 012-2h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V6zM16 2v4M8 2v4M3 10h18',
  pin: 'M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11zM12 7.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5z',
  mode: 'M4 5h16a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1zM2 20h20',
  cup: 'M8 21h8M12 17v4M7 4h10v5a5 5 0 01-10 0V4zM7 6H4a3 3 0 003 4M17 6h3a3 3 0 01-3 4',
  team: 'M9 11a3 3 0 100-6 3 3 0 000 6zM3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M17 10a2.5 2.5 0 100-5M16 14.5c3 0 5 1.5 5 5.5',
};
const logoList = sponsors.list;
const chips = [[chip.pin, ev.venue], [chip.mode, ev.mode], [chip.team, ev.teamSize], [chip.cup, prizes.total]];
const split = (s: string) => [...s];
const prizeFig = '₹1.5 Lakh+';
const pi = prizes.total.indexOf(prizeFig);
const prizeHead = pi > 0 ? prizes.total.slice(0, pi) : '';
const prizeTail = pi >= 0 ? prizes.total.slice(pi + prizeFig.length) : '';
---
<section class="story" id="top" aria-label={`${ev.name} ${ev.year}`}>
  <Skyline mode="defs" />
  <div class="stage">
    <span class="streak s-a" aria-hidden="true"></span><span class="streak s-b" aria-hidden="true"></span>
    <Skyline cls="city" label={story.ground.alt} /><span class="scrim" aria-hidden="true"></span>
    <div class="wipes" aria-hidden="true">{[0, 1, 2, 3, 4].map((i) => <span class="wipe" style={`--bi:${i + 1}`}></span>)}</div>

    <!-- 1 · SPARK -->
    <article class="frame f1" style="--fi:0">
      <Skyline cls="s s-hero" label={story.ground.alt} />
      <div class="in sketch-hero-container">
        <!-- TOP: Registration Countdown -->
        <div class="hero-top-timer">
          <RegLine live />
        </div>

        <!-- CENTER: Main Content -->
        <div class="hero-hero-center">

          <h1 id="hero-title" class="hero-title-sketch">
            <span class="sr">{`${ev.name} ${ev.year}`}</span>
            <svg class="hero-title-svg" viewBox="0 0 1400 160" width="100%" height="160" preserveAspectRatio="xMidYMid meet" role="img" aria-label="SRIJAN .2K26/">
              <defs>
                <linearGradient id="refOrangeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#ff5b00" />
                  <stop offset="60%" stop-color="#ff8a33" />
                  <stop offset="100%" stop-color="#ffb86c" />
                </linearGradient>
                <linearGradient id="refWhiteGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#ffffff" />
                  <stop offset="100%" stop-color="#e0e6ed" />
                </linearGradient>
                <filter id="refSoftGlow" x="-30%" y="-30%" width="160%" height="160%">
                  <feDropShadow dx="0" dy="8" stdDeviation="16" flood-color="#ff5b00" flood-opacity="0.55" />
                  <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#ff9900" flood-opacity="0.75" />
                </filter>
              </defs>
              <g filter="url(#refSoftGlow)">
                <text x="700" y="122" text-anchor="middle" class="ref-title-text">
                  <tspan class="ref-white">SRIJAN</tspan>
                  <tspan class="ref-orange"> .2K26</tspan>
                  <tspan class="ref-slash">/</tspan>
                </text>
              </g>
            </svg>
          </h1>

          <p class="tagline-ref">
            <span>BUILD<span class="dot-o">.</span></span>
            <span>CREATE<span class="dot-o">.</span></span>
            <span>IMPACT<span class="dot-o">.</span></span>
          </p>

          <p class="sub-flagship">FLAGSHIP INTER-COLLEGE HACKATHON</p>

          <div class="hero-pills-row">
            <div class="ref-glass-pill">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              <span>13–14 OCTOBER 2026</span>
            </div>
            <div class="ref-glass-pill">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>SRMCEM • LUCKNOW</span>
            </div>
          </div>

          <div class="hero-dual-cta">
            <a class="btn btn-primary btn-ref-orange" data-reg-btn data-register data-magnetic href={register.href} target="_blank" rel="noopener noreferrer">{register.label} ↗</a>
            <a class="btn btn-ghost btn-ref-ghost" data-magnetic href="#about">EXPLORE DETAILS ⌄</a>
          </div>
        </div>

        <!-- BOTTOM: Sponsored by -->
        <div class="sponsored hero-bottom-sponsors" id="partners">
          <p class="sp-label">{sponsors.label}</p>
          <ul class="sp-logos" aria-label={sponsors.label}>
            {logoList.map((l) => <li><Img src={logos[l.logo]} widths={[l.w]} fallbackWidth={l.w} sizes={`${l.w}px`} alt={l.alt} width={l.w} height={l.h} loading="eager" /></li>)}
          </ul>
        </div>
      </div>
    </article>

    <!-- 2 · GROUND (start-small line; the skyline is the stage-level .city when pinned, the hero's .s-hero otherwise) -->
    <article class="frame f2" id="ground" style="--fi:1">
      <div class="f-copy"><h2 class="line display">{story.ground.line}</h2>{story.ground.sub.map((t) => <p class="sub">{t}</p>)}</div>
    </article>

    <!-- 3 · DOMAINS -->
    <article class="frame f3" id="battlefield" style="--fi:2">
      <div class="f-copy top"><h2 class="line display">{story.domains.line}</h2><p class="sub">{story.domains.sub}</p></div>
      <ul class="doms">
        {tracks.list.map((t, i) => (
          <li class="dom" data-spring style={`--j:${i}`}><div class="dom-in"><svg class="dom-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[story.domains.icons[i]]}/></svg><span class="dom-tx"><strong>{t}</strong><span class="dom-l">{tracks.lines[i]}</span></span></div></li>
        ))}
      </ul>
    </article>

    <!-- 4 · PATH -->
    <article class="frame f4" id="path" style="--fi:3">
      <div class="f-copy top"><h2 class="line display">{story.path.line}</h2><p class="sub">{story.path.sub}</p></div>
      <ol class="steps5" data-timeline>
        <svg class="tl-svg" aria-hidden="true" focusable="false"><path class="tl-path" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {story.path.steps.map((s, i) => {
          const vis = s.sub.replace(`${s.day} ${story.path.month}`, '').replace(/^[\s·]+/, '');
          return (
          <li class="st" data-step style={`--j:${i}`}>{i === 0 && <span class="st-mark" aria-hidden="true"></span>}<span class="dot" aria-hidden="true"><b>{s.day}</b><i>{story.path.month}</i></span><span class="txt"><strong>{s.title}</strong>{' '}{vis !== s.sub ? <><span class="sr">{s.sub.slice(0, s.sub.length - vis.length).trim()}</span>{vis && <>{' '}<span>{vis}</span></>}</> : <span>{s.sub}</span>}{s.note && <>{' '}<span class="note">{s.note}</span></>}</span></li>
          );
        })}
      </ol>
      <p class="f-copy path-links"><a class="flink" href={story.path.link.href}>{story.path.link.label}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow}/></svg></a><span class="sub small soonnote"> {data.schedule.footnote}</span></p>
    </article>

    <!-- 5 · REWARD -->
    <article class="frame f5" id="reward" style="--fi:4">
      <div class="f-art reward-float">
        <svg class="a-trophy" viewBox="0 0 200 170" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Trophy">
          <ellipse class="plat" cx="100" cy="152" rx="58" ry="6"/>
          <g class="rays"><path d="M100 80L20 12M100 80L100 0M100 80L180 12M100 80L2 70M100 80L198 70"/></g>
          <g class="trophy"><path class="gold" d="M62 30h76v34c0 22-17 38-38 38S62 86 62 64V30z"/><path class="handles" d="M62 38H38c0 22 8 34 26 38M138 38h24c0 22-8 34-26 38"/><path class="gold" d="M92 102h16v20H92zM78 122h44v12H78zM70 134h60v14H70z"/></g>
        <g class="sparks"><path style="--d:0" d="M30 40l3 7 7 3-7 3-3 7-3-7-7-3 7-3z"/><path style="--d:1" d="M170 52l2.5 6 6 2.5-6 2.5-2.5 6-2.5-6-6-2.5 6-2.5z"/><path style="--d:2" d="M52 110l2 5 5 2-5 2-2 5-2-5-5-2 5-2z"/><path style="--d:3" d="M150 118l2 5 5 2-5 2-2 5-2-5-5-2 5-2z"/><path style="--d:4" d="M100 8l2 5 5 2-5 2-2 5-2-5-5-2 5-2z"/></g>
        </svg>
      </div>
      <div class="f-copy"><h2 class="line total display" data-prize><span class="sr">{prizes.total}</span><span class="prize-fx" aria-hidden="true"><span class="prize-head">{prizeHead}</span><span class="prize-scramble prize-fig">{prizeFig}</span><span class="prize-tail">{prizeTail}</span></span></h2><p class="motto display">{prizes.motto.map((m, i) => <><span>{m}</span>{i < prizes.motto.length - 1 && <i aria-hidden="true">•</i>}</>)}</p></div>
    </article>
  </div>
</section>

<script>import '../scripts/reg-countdown.ts';</script>
