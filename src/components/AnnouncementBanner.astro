---
import data from '../data/event.json';
const { register, announcement } = data;
---

<aside class="top-announcement-bar" role="region" aria-label="Registration Deadline Extension Notice">
  <div class="announcement-wrap">
    <div class="announcement-content">
      <span class="announcement-badge">
        <span class="announcement-pulse-dot" aria-hidden="true"></span>
        <span class="announcement-icon" aria-hidden="true">⚡</span>
        <span>REGISTRATION EXTENDED</span>
      </span>
      <p class="announcement-message">
        <strong>Deadline extended to 13 Oct, 12:00 PM IST</strong> on popular request. Secure your team's spot before entries close!
      </p>
    </div>
  </div>
</aside>

<style>
  .top-announcement-bar {
    position: relative;
    z-index: 55;
    background: linear-gradient(90deg, #180d04 0%, #291202 30%, #1c0e05 70%, #120a03 100%);
    border-bottom: 1px solid rgba(255, 106, 0, 0.45);
    box-shadow: 0 4px 20px rgba(255, 91, 0, 0.18), inset 0 1px 0 rgba(255, 200, 100, 0.2);
    color: #fdfdfd;
    font-size: 0.86rem;
    line-height: 1.35;
    padding: 0.55rem 1rem;
    overflow: hidden;
  }

  .top-announcement-bar::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(255, 106, 0, 0.25) 0%, transparent 75%);
    pointer-events: none;
  }

  .announcement-wrap {
    max-width: 82rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }

  .announcement-content {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .announcement-tag-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .announcement-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: linear-gradient(135deg, #ff5b00, #ff8a00);
    color: #050505;
    font-weight: 900;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    box-shadow: 0 0 14px rgba(255, 91, 0, 0.6);
  }

  .announcement-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #000;
    box-shadow: 0 0 6px #000;
    animation: pulseDot 1.4s infinite ease-in-out;
  }

  @keyframes pulseDot {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.4); opacity: 1; }
  }

  .announcement-icon {
    font-size: 0.8rem;
    line-height: 1;
  }

  .announcement-date-pill {
    display: inline-block;
    background: rgba(255, 91, 0, 0.18);
    border: 1px solid rgba(255, 120, 20, 0.4);
    color: #ffb570;
    font-weight: 700;
    font-size: 0.74rem;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .announcement-message {
    margin: 0;
    color: #e5e5e5;
    font-size: 0.84rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .announcement-headline {
    color: #ffffff;
    font-weight: 800;
  }

  .announcement-sep {
    color: rgba(255, 106, 0, 0.6);
    font-weight: bold;
  }

  .announcement-reason {
    color: #ffdcb5;
  }

  .announcement-action {
    color: #ffffff;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(255, 106, 0, 0.6);
    text-underline-offset: 3px;
  }

  .announcement-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: linear-gradient(135deg, #ff6600, #ff8c20);
    color: #080808 !important;
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    box-shadow: 0 2px 10px rgba(255, 91, 0, 0.35);
    white-space: nowrap;
    flex-shrink: 0;
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .announcement-cta:hover {
    transform: translateY(-1px) scale(1.03);
    box-shadow: 0 4px 18px rgba(255, 91, 0, 0.65);
    background: linear-gradient(135deg, #ff7b1a, #ffa038);
    color: #000 !important;
  }

  .cta-arrow {
    width: 14px;
    height: 14px;
    transition: transform 160ms ease;
  }

  .announcement-cta:hover .cta-arrow {
    transform: translateX(2px);
  }

  @media (max-width: 58rem) {
    .announcement-wrap {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }
    .announcement-message {
      font-size: 0.8rem;
    }
    .announcement-cta {
      align-self: flex-start;
      margin-top: 0.2rem;
    }
  }

  @media (max-width: 32rem) {
    .top-announcement-bar {
      padding: 0.5rem 0.75rem;
    }
    .announcement-sep {
      display: none;
    }
    .announcement-message {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
