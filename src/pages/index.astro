---
import Img from '../components/Img.astro';
import Base from '../layouts/Base.astro';
import data from '../data/event.json';
import venue from '../assets/venue.jpg';
import poster from '../assets/poster.jpg';
import Story from '../components/Story.astro';
import EmberBg from '../components/EmberBg.astro';
import Motion from '../components/Motion.astro';
import RegLine from '../components/RegLine.astro';
import srmcemLogo from '../assets/logos/srmcem.webp';
import csiLogo from '../assets/logos/csi-srmcem.webp';
import gfgLogo from '../assets/logos/gfg-srmcem.webp';

const ps = data.tracks.problemStatements;
const { event: ev, venue: venueInfo, register, nav, about, schedule, prizes, how, sponsors, faq, contact, fee, registration } = data;
const cp = Object.fromEntries(new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', hourCycle: 'h12' }).formatToParts(new Date(registration.closes)).map((p) => [p.type, p.value]));
const closesShort = `${cp.day} ${cp.month}, ${cp.hour}:${cp.minute} ${String(cp.dayPeriod).toUpperCase()} IST`; // 11 Oct, 12:00 PM IST
const tagline = ev.tagline;
const orgLogos = [
  { src: srmcemLogo, alt: 'SRMCEM', w: 128, h: 128, tile: false },
  { src: csiLogo, alt: 'CSI SRMCEM', w: 256, h: 256, tile: true },
  { src: gfgLogo, alt: 'GFG SRMCEM', w: 189, h: 148, tile: true },
];
---
<Base>
  <EmberBg />
  <Motion />
  <a class="skip" href="#about">Skip to details</a>
  <div class="progress" aria-hidden="true"></div>

  <header class="top">
    <div class="wrap">
      <a href="#top" class="brand-logo-ref" aria-label="SRIJAN 2K26 Home">
        <div class="brand-org-circles">
          <span class="org-circle-badge" title="CSI SRMCEM"><img src={csiLogo.src} alt="CSI" width="24" height="24" /></span>
          <span class="org-circle-badge" title="GFG SRMCEM"><img src={gfgLogo.src} alt="GFG" width="24" height="24" /></span>
          <span class="org-circle-badge" title="SRMCEM"><img src={srmcemLogo.src} alt="SRMCEM" width="24" height="24" /></span>
        </div>
      </a>

      <div class="nav-capsule-pill">
        <nav class="nav" aria-label="Primary">
          {nav.map((n) => <a href={n.href} data-f={n.frame}>{n.label}</a>)}
        </nav>
      </div>

      <a class="btn btn-primary top-cta-btn" data-reg-btn data-magnetic href={register.href} target="_blank" rel="noopener noreferrer">{register.label} ↗</a>

      <details class="menu">
        <summary aria-expanded="false"><span class="bars" aria-hidden="true"></span>Menu</summary>
        <ul aria-label="Sections">
          {nav.map((n) => <li><a href={n.href} data-f={n.frame}>{n.label}</a></li>)}
        </ul>
      </details>
    </div>
  </header>

  <div class="dock" id="dock"><div class="dock-in">
    <a class="btn btn-primary" data-reg-btn data-magnetic href={register.href} target="_blank" rel="noopener noreferrer">
      {register.label}<span class="sr"> (opens in a new tab)</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
    <p class="dock-close">Closes {closesShort}</p>
  </div></div>

  <main id="main">
    <Story />

    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {[0, 1].map(() => (
          <div class="ticker-set">
            {[0, 1, 2].map(() => tagline.map((t, i) => <span class={i === 2 ? 'o' : ''}>{t} •</span>))}
          </div>
        ))}
      </div>
    </div>

    <!-- ABOUT -->
    <section id="about" aria-labelledby="about-h">
      <div class="wrap">
        <div class="about-grid">
          <div>
            <p class="eyebrow" data-reveal><b>01</b> About</p>
            <h2 id="about-h" class="display h2" data-reveal>{about.heading}</h2>
            <div data-stagger style="margin-top:1.5rem">
              {about.body.map((p, i) => <p class="lead" style={`--i:${i}`}>{p}</p>)}
            </div>
            <p class="about-org" data-reveal><strong>{ev.organizers}</strong> in collaboration with <strong>{ev.collaborator}</strong></p>
            <div class="explainer" data-reveal><h3>{about.explainer.heading}</h3><p>{about.explainer.text}</p></div>
            <ul class="glance" data-stagger aria-label="At a glance">
              {about.cards.map((c, i) => <li style={`--i:${i}`}><span class="k">{c.k}</span><strong>{c.t}</strong><span class="d">{c.d}</span></li>)}
            </ul>
          </div>
          <figure class="poster" data-reveal>
            <Img src={poster} fallbackWidth={520} widths={[360, 520, 660, 780]} sizes="(min-width: 56rem) 26rem, 90vw" width={520} height={780}
              alt="SRIJAN 2K26 inter-college hackathon poster: 13–14 Oct 2026, SRMCEM Campus Lucknow, hybrid mode" loading="lazy" />
            <figcaption>Official poster</figcaption>
          </figure>
        </div>

        <figure class="venue" data-reveal>
          <Img src={venue} fallbackWidth={768} widths={[400, 560, 768, 1024]} sizes="(min-width: 76rem) 70rem, 92vw" width={1024} height={380}
            alt="SRMCEM campus building with the golden Ashoka lion capital statue in front" loading="lazy" />
          <figcaption>{about.venueCaption}</figcaption>
          <p class="venue-go"><a class="btn btn-ghost" href={venueInfo.mapsHref} target="_blank" rel="noopener noreferrer" data-venue-map>{venueInfo.directionsLabel}<span class="sr"> (opens in a new tab)</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a><span class="venue-note">{venueInfo.note}</span></p>
        </figure>
      </div>
    </section>

    <!-- PROBLEM STATEMENTS (draft list; native <details> so every row works without JS) -->
    <section id="problem-statements" class="ps" aria-labelledby="ps-h">
      <div class="wrap">
        <h2 id="ps-h" class="display">{ps.heading}</h2>
        <p class="ps-note">{ps.note}</p>
        <ol class="ps-list">
          {ps.items.map((it, i) => (
            <li>
              <details>
                <summary><span class="ps-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="ps-t">{it.title}</span><span class="ps-i" aria-hidden="true"></span></summary>
                <p class="ps-d">{it.text}</p>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how" class="alt" aria-labelledby="how-h">
      <div class="wrap">
        <p class="eyebrow" data-reveal><b>02</b> How it works</p>
        <h2 id="how-h" class="display h2" data-reveal>{how.heading}</h2>
        <p class="lead" data-reveal>{how.intro}</p>
        <ol class="stepper" data-stagger aria-label={how.aria} data-timeline>
          <svg class="tl-svg" aria-hidden="true" focusable="false"><path class="tl-path" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {how.steps.map((s, k) => (
            <li class="stp" style={`--i:${k}`}>
              <span class="num" aria-hidden="true">{k + 1}</span>
              <div class="body">
                <h3>{s.title}</h3>
                <p>{s.reward ? `${prizes.total}.` : s.text}</p>
                {s.tag && <span class="pill">{s.tag}</span>}
              </div>
            </li>
          ))}
        </ol>
        <div class="fee" data-reveal>
          <p class="fee-h">{fee.heading} <span>{fee.note}</span></p>
          <p class="fee-cap">{fee.caption}</p>
          <ul class="fee-tiers" aria-label={fee.heading}>
            {fee.tiers.map((t) => <li><span class="who">{t.label}</span><strong>{t.amount}</strong></li>)}
          </ul>
        </div>
        <div class="cta" data-reveal>
          <p class="display yourmove">{how.cta}</p>
          <div style="display:flex; flex-wrap:wrap; gap:1rem; align-items:center; justify-content:center;">
            <a class="btn btn-primary btn-lg" data-reg-btn data-magnetic href={register.href} target="_blank" rel="noopener noreferrer" data-register>{register.label}<span class="sr"> (opens in a new tab)</span></a>
            <a class="btn btn-whatsapp btn-lg" href="https://chat.whatsapp.com/Kx2qldtBQjH5vQzuw3xdLM" target="_blank" rel="noopener noreferrer" title="Join Srijan 2K26 WhatsApp Group">
              <svg viewBox="0 0 24 24" fill="currentColor" class="wa-ic" aria-hidden="true"><path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.32a8.182 8.182 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.42 5.83c0 4.54-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.12-.56.12-.17.25-.64.8-.79.96-.15.17-.3.19-.55.07-.25-.12-1.05-.39-2.01-1.24-.74-.66-1.24-1.47-1.39-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.22-.16-.47-.28z"/></svg>
              <span>Join WhatsApp Group</span>
            </a>
          </div>
          <RegLine cls="rl-cta" />
        </div>
      </div>
    </section>

    <!-- CASH PRIZES & REWARDS -->
    <section id="reward" class="prizes-section" aria-labelledby="prize-h">
      <div class="wrap">
        <p class="eyebrow" data-reveal><b>03</b> Cash Prizes & Rewards</p>
        <h2 id="prize-h" class="display h2" data-reveal>{prizes.heading}</h2>
        <p class="lead" data-reveal>{prizes.sub}</p>

        <!-- 3 Prize Cards Grid -->
        <div class="prizes-grid" data-stagger>
          {prizes.cards.map((c, i) => (
            <div class={`prize-card ${c.featured ? 'featured' : ''}`} style={`--i:${i}`}>
              <div class="prize-badge">{c.tag}</div>
              <div class="prize-icon-wrap">
                <span class="prize-icon">{c.icon}</span>
              </div>
              <h3 class="prize-rank">{c.rank}</h3>
              <span class="prize-pos">{c.position}</span>
              <div class="prize-suspense-box">
                <span class="suspense-lock">🔒</span>
                <span class="suspense-text">{c.suspense}</span>
              </div>
              <p class="prize-perks">{c.prizeText}</p>
            </div>
          ))}
        </div>

        <!-- Suspense Banner -->
        <div class="prizes-suspense-banner" data-reveal>
          <span class="suspense-sparkle">✨</span>
          <p>{prizes.suspenseNote}</p>
        </div>

        <!-- Mandatory Presentation / PPT Announcement Banner -->
        <div class="ppt-notice-box" data-reveal>
          <div class="ppt-notice-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ppt-ic"><rect width="18" height="14" x="3" y="3" rx="2"/><path d="M7 21h10M12 17v4M8 8h8M8 12h5"/></svg>
          </div>
          <div class="ppt-notice-content">
            <h4>{prizes.pptNotice.title}</h4>
            <p>{prizes.pptNotice.text}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SCHEDULE -->
    <section id="schedule" class="alt" aria-labelledby="sch-h">
      <div class="wrap">
        <p class="eyebrow" data-reveal><b>04</b> Schedule</p>
        <h2 id="sch-h" class="display h2" data-reveal>{schedule.heading}</h2>
        <div class="days-grid" data-stagger data-schedule-tabs>
          {schedule.days.map((d, i) => (
            <details class="day" open style={`--i:${i}`}>
              <summary>
                <span>
                  <span class="d">{d.day}</span><br />
                  <span class="date">{d.date}</span><br />
                  <span class="mode">{d.mode}</span>
                </span>
                <span class="chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
              </summary>
              <p class="blurb">{d.blurb}</p>
              <ol>{d.items.map((it) => <li>{it}</li>)}</ol>
            </details>
          ))}
        </div>
        <p class="foot-note" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          {schedule.footnote}
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" aria-labelledby="faq-h">
      <div class="wrap">
        <p class="eyebrow" data-reveal><b>05</b> FAQ</p>
        <h2 id="faq-h" class="display h2" data-reveal>{faq.heading}</h2>
        <div class="faq" data-stagger>
          {faq.items.map((f, i) => (
            <details data-faq style={`--i:${i}`}>
              <summary aria-expanded="false" aria-controls={`faq-a${i}`}>{f.q}<span class="plus" aria-hidden="true"></span></summary>
              <div class="faq-panel" id={`faq-a${i}`}><div class="faq-in"><p class="a" {...(f.regClose ? { 'data-reg-faq': '', 'data-closed-text': f.a.replace('closes on', 'closed on') } : f.closedA ? { 'data-reg-past': '', 'data-closed-text': f.closedA } : {})}>{f.a}</p></div></div>
            </details>
          ))}
        </div>
        <p class="faq-more" data-reveal>{faq.contactPointer.text} <a href={faq.contactPointer.href}>{faq.contactPointer.linkLabel}</a></p>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="contact alt" aria-labelledby="ct-h">
      <div class="wrap">
        <p class="eyebrow" data-reveal><b>06</b> Join in</p>
        <h2 id="ct-h" class="display" data-reveal>{contact.heading}</h2>
        <p class="lead" data-reveal data-reg-copy data-closed-text={contact.closedText}>{contact.text}</p>
        <div class="tech-quote-card" data-reveal>
          <div class="tech-card-badge">SRIJAN 2K26 INNOVATION HUB</div>
          <p class="tech-card-quote">"The future is built by those who code it. 36 Hours of relentless innovation, cutting-edge AI & Open Source solutions."</p>
          <div class="tech-card-stats">
            <div class="stat-box"><span class="stat-num">36h</span><span class="stat-lbl">NON-STOP HACKING</span></div>
            <div class="stat-box"><span class="stat-num">6+</span><span class="stat-lbl">TECH DOMAINS</span></div>
            <div class="stat-box"><span class="stat-num">₹1.5L+</span><span class="stat-lbl">PRIZE POOL</span></div>
            <div class="stat-box"><span class="stat-num">500+</span><span class="stat-lbl">INNOVATORS</span></div>
          </div>
        </div>

        <div class="whatsapp-card" data-reveal>
          <div class="wa-card-content">
            <div class="wa-icon-wrap">
              <svg viewBox="0 0 24 24" fill="currentColor" class="wa-banner-ic" aria-hidden="true"><path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.32a8.182 8.182 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.42 5.83c0 4.54-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.12-.56.12-.17.25-.64.8-.79.96-.15.17-.3.19-.55.07-.25-.12-1.05-.39-2.01-1.24-.74-.66-1.24-1.47-1.39-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.53.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.22-.16-.47-.28z"/></svg>
            </div>
            <div class="wa-card-info">
              <h3 class="wa-card-h">Official Srijan 2K26 WhatsApp Group</h3>
              <p class="wa-card-p">Join for instant announcements, team finding, rules updates & real-time query support.</p>
            </div>
          </div>
          <a href="https://chat.whatsapp.com/Kx2qldtBQjH5vQzuw3xdLM" target="_blank" rel="noopener noreferrer" class="btn btn-wa-action">Join Group ↗</a>
        </div>
      </div>
    </section>

    <!-- ORGANIZING TEAM & LEADS -->
    <section id="team" class="team-section" aria-labelledby="team-h">
      <div class="wrap">
        <div class="ask" id="contact-us" data-reveal>
          <h2 id="team-h" class="display">{contact.questions.heading}</h2>
          <ul class="people" data-stagger>
            {contact.questions.people.slice(0, 3).map((c, i) => (
              <li style={`--i:${i}`}>
                <div class="person-card">
                  <div class="person-avatar">
                    <img loading="lazy" decoding="async" src={c.image.replace(/\.(png|jpg)$/, '.webp')} alt={c.name} class="avatar-img" width="60" height="60" />
                  </div>
                  <div class="person-details">
                    <strong class="person-name">{c.name}</strong>
                    <span class="person-role">{c.role}</span>
                    <div class="person-actions">
                      <a class="person-action mail-action" href={`mailto:${c.email}`} title={`Email ${c.name}`}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="action-icon"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        <span>{c.email}</span>
                      </a>
                      {c.linkedin && (
                        <a class="person-action linkedin-action" href={c.linkedin} target="_blank" rel="noopener noreferrer" title={`${c.name} on LinkedIn`}>
                          <svg viewBox="0 0 24 24" fill="currentColor" class="action-icon linkedin-icon"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.77a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8Z"/></svg>
                          <span>LinkedIn Profile</span>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ul>

          <h3 class="display sub-team-h" style="margin-top: 3.5rem; font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: #ffffff;">Technical Executives</h3>
          <ul class="people people-execs" data-stagger>
            {contact.questions.people.slice(3).map((c, i) => (
              <li style={`--i:${i}`}>
                <div class="person-card">
                  <div class="person-avatar">
                    <img loading="lazy" decoding="async" src={c.image.replace(/\.(png|jpg)$/, '.webp')} alt={c.name} class="avatar-img" width="60" height="60" />
                  </div>
                  <div class="person-details">
                    <strong class="person-name">{c.name}</strong>
                    <span class="person-role">{c.role}</span>
                    <div class="person-actions">
                      <a class="person-action mail-action" href={`mailto:${c.email}`} title={`Email ${c.name}`}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="action-icon"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        <span>{c.email}</span>
                      </a>
                      {c.linkedin && (
                        <a class="person-action linkedin-action" href={c.linkedin} target="_blank" rel="noopener noreferrer" title={`${c.name} on LinkedIn`}>
                          <svg viewBox="0 0 24 24" fill="currentColor" class="action-icon linkedin-icon"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.77a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8Z"/></svg>
                          <span>LinkedIn Profile</span>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
